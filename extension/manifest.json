{
  "manifest_version": 3,
  "name": "Inbox Triage BETA",
  "version": "0.1.0",
  "description": "A live Inbox Triage dashboard at the top of Gmail: what needs you, what can wait, sorted as mail arrives.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "identity"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://mail.google.com/*"], "js": ["lib.js", "content.js"], "run_at": "document_idle" }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Inbox Triage settings" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
