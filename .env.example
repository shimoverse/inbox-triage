# Copy to .env (git-ignored) or ~/.config/inbox-triage/.env and fill in.

# Required when self-hosting: Jev by TypeSafe makes every triage decision. Get a key at https://console.typesafe.ai/
# (A hosted server ignores this; each user connects their own Jev key in the app.)
TYPESAFE_API_KEY=

# Optional: turns typed onboarding notes into rules (DeepSeek V4.1 Flash via OpenRouter).
OPENROUTER_API_KEY=
# INBOX_TRIAGE_ASSIST_MODEL=deepseek/deepseek-v4.1-flash

# Optional for whoever runs/distributes the app: one Google OAuth client for everyone (see docs/hosting.md).
# INBOX_TRIAGE_OAUTH_CLIENT_ID=
# INBOX_TRIAGE_OAUTH_CLIENT_SECRET=
