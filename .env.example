# Copy to .env (git-ignored) or ~/.config/inbox-triage/.env and fill in.

# Jev by TypeSafe makes every triage decision. One OpenRouter key (https://openrouter.ai/keys) runs Jev
# and the notes assistant (DeepSeek V4.1 Flash); a TypeSafe key (https://console.typesafe.ai/) also works for Jev.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# INBOX_TRIAGE_ASSIST_MODEL=deepseek/deepseek-v4.1-flash

# Hosted servers ignore their own Jev key unless the operator sponsors a free beta: this many Jev calls
# per account per day (UTC) are paid with the key above. See docs/hosting.md.
# INBOX_TRIAGE_SPONSORED_JEV_DAILY=500

# Hosted servers only: the Chrome/Brave extension IDs allowed to sign in (comma-separated). See extension/README.md.
# INBOX_TRIAGE_EXTENSION_IDS=

# Optional for whoever runs/distributes the app: one Google OAuth client for everyone (see docs/hosting.md).
# INBOX_TRIAGE_OAUTH_CLIENT_ID=
# INBOX_TRIAGE_OAUTH_CLIENT_SECRET=
